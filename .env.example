# Telegram notifications
# Get a bot token from @BotFather, get chat IDs from @userinfobot.
# First ID listed is the admin account: it receives error/failure notifications
# on every failed run. All IDs receive slot-available alerts.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_IDS=111111111,222222222

# Exact Spanish text shown on the page when there are no appointment slots
NO_SLOTS_TEXT=En este momento no hay citas disponibles.

# Target URL (province pre-selected via p=8 for Barcelona)
TARGET_URL=https://icp.administracionelectronica.gob.es/icpplustieb/citar?p=8&locale=es

# Residential proxy (required — the site geoblocks non-Spanish IPs)
# Get credentials from your proxy provider (e.g. IPRoyal). Country/city targeting
# is embedded in the password string; a session id is auto-appended per run if omitted.
PROXY_SERVER=http://geo.iproyal.com:12321
PROXY_USER=your_proxy_username
PROXY_PASS=your_proxy_password_country-es_city-barcelona
